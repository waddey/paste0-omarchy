#!/usr/bin/env python3
"""Create an unlisted paste on paste0.com.

Body is read from stdin (never argv). Prints one JSON object on stdout.
"""
from __future__ import annotations

import json
import sys
import urllib.error
import urllib.request
from urllib.parse import urlparse

MAX_BYTES = 2 * 1024 * 1024
# Create responses are a tiny JSON object ({ok,id,url,raw} or {ok,message}).
# Cap + one byte so a hostile apiUrl cannot fill RAM or flood StdioCollector.
MAX_RESPONSE_BYTES = 8 * 1024
DEFAULT_API = "https://paste0.com/api"
ALLOWED_EXPIRY = {"10min", "1hour", "1day", "1week", "1month"}


def fail(message: str, code: int = 1) -> None:
    json.dump({"ok": False, "message": message}, sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")
    raise SystemExit(code)


def read_capped(stream) -> bytes:
    data = stream.read(MAX_RESPONSE_BYTES + 1)
    if len(data) > MAX_RESPONSE_BYTES:
        fail("Response too large")
    return data


def api_url(raw: str) -> str:
    value = (raw or DEFAULT_API).strip().rstrip("/")
    if not value.endswith("/api"):
        value = value + "/api"
    parsed = urlparse(value)
    if parsed.scheme != "https" or not parsed.netloc:
        fail("API URL must be https")
    if parsed.username or parsed.password:
        fail("API URL must not include credentials")
    return value


def main() -> None:
    api = api_url(sys.argv[1] if len(sys.argv) > 1 else DEFAULT_API)
    expiry = sys.argv[2] if len(sys.argv) > 2 else "1week"
    title = sys.argv[3] if len(sys.argv) > 3 else ""
    syntax = sys.argv[4] if len(sys.argv) > 4 else "auto"
    if expiry not in ALLOWED_EXPIRY:
        expiry = "1week"
    if syntax == "":
        syntax = "auto"

    body = sys.stdin.buffer.read(MAX_BYTES + 1)
    if len(body) > MAX_BYTES:
        fail("Paste too large")
    text = body.decode("utf-8", "replace")
    if not text.strip():
        fail("Empty paste")

    payload = json.dumps(
        {"c": text, "title": title, "syntax": syntax, "e": expiry},
        ensure_ascii=False,
    ).encode("utf-8")
    req = urllib.request.Request(
        api,
        data=payload,
        method="POST",
        headers={
            "Content-Type": "application/json",
            "Accept": "application/json",
            "X-Paste0-Client": "omarchy",
            "User-Agent": "omarchy/0.1",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=20) as response:
            raw = read_capped(response)
    except urllib.error.HTTPError as err:
        try:
            raw = read_capped(err)
        finally:
            err.close()
        if not raw:
            fail(str(err.reason or "Request failed"))
    except Exception as err:
        fail(str(err))

    try:
        data = json.loads(raw.decode("utf-8", "replace"))
    except Exception:
        fail("Bad response")
    if not isinstance(data, dict):
        fail("Bad response")
    json.dump(data, sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")
    if data.get("ok") is not True:
        raise SystemExit(1)


if __name__ == "__main__":
    main()
